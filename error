# Install Cloud Foundry CLI v8
Write-Host "Installing Cloud Foundry CLI..."

curl -L "https://packages.cloudfoundry.org/stable?release=linux64-binary&version=v8" -o cf-cli.tgz
tar -xzf cf-cli.tgz
sudo mv cf /usr/local/bin

cf --version

# Install MultiApps plugin
Write-Host "Installing MultiApps plugin..."
cf install-plugin multiapps -f

# Locate MTAR artifact
$mtar = Get-ChildItem -Path "$(System.DefaultWorkingDirectory)" -Recurse -Filter *.mtar | Select-Object -First 1
Write-Host "MTAR File found:" $mtar.FullName

# Login to SAP BTP Cloud Foundry
cf api https://api.cf.ap21.hana.ondemand.com
cf auth $(AdminUser) $(AdminPass)

# Target Org and Space
cf target -o $(Organisation) -s $(Environment)

# Deploy the MTAR
Write-Host "Deploying MTAR..."
cf deploy $mtar.FullName -f --abort-on-error

# Detect deployed apps
Write-Host "Detecting deployed applications..."
$appList = cf apps | Select-String "started"

foreach ($app in $appList) {
    $appName = ($app -split "\s+")[0]
    Write-Host "Setting deployment metadata for $appName"

    cf set-env $appName DEPLOYED_BY "AzureDevOps"
    cf set-env $appName BUILD_NUMBER "$(Build.BuildNumber)"
    cf set-env $appName RELEASE_NAME "$(Release.ReleaseName)"
    cf set-env $appName GIT_BRANCH "$(Build.SourceBranchName)"
    cf set-env $appName COMMIT_ID "$(Build.SourceVersion)"

    cf restart $appName
}
